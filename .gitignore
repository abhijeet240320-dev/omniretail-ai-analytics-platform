# ============================================================
# OmniRetail AI Analytics Platform - files git must never track
# ============================================================

# --- Secrets: NEVER commit real credentials -----------------
.env
.env.*
# The template IS committed; it has no real secrets. The comment sits on its
# own line on purpose: gitignore has no inline comments, so a trailing "# ..."
# becomes part of the pattern and silently negates nothing.
!.env.example

# --- Python virtual environment -----------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Local PostgreSQL cluster -------------------------------
# This machine keeps the cluster OUTSIDE the repository (in ~/.omniretail)
# because OneDrive-synced folders break PostgreSQL. This rule is a safety net
# in case anyone ever initialises a cluster inside the project by mistake.
.pgdata/
*.pgdata/
postmaster.pid

# --- Tool caches --------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.freebuff/

# --- Raw data: large, reproducible, stays on your machine ---
# We deliberately DO commit data/raw/_checksums.json and
# data/raw/_measurements.json. They are tiny, and they are the evidence that
# the data analysed is the data we downloaded. Everything else under raw/ is
# regenerated by backend/scripts/data/01_download.py.
data/raw/**
!data/raw/_checksums.json
!data/raw/_measurements.json
!data/raw/.gitkeep
!data/raw/dunnhumby/
!data/raw/dataco/
!data/raw/olist/
!data/raw/m5/
!data/raw/dunnhumby/.gitkeep
!data/raw/dataco/.gitkeep
!data/raw/olist/.gitkeep
!data/raw/m5/.gitkeep

# --- Processed data: derived, regenerated by the pipeline ---
data/processed/**
!data/processed/.gitkeep
# The measurement reports ARE committed. They are not data; they are the
# evidence. `_sql_results.json` is what every figure in docs/sql_analytics.md
# is checked against, `_forecast_results.json` and `_anomaly_results.json` are
# what /api/forecasting and /api/anomalies serve, and `_load_report.json`,
# `_verify_report.json` and `_audit_report.json` are the independent verdicts.
# Without them a fresh clone has no proof of anything, and roughly a dozen
# tests cannot run. They total well under 300 kB.
!data/processed/_*.json
!data/processed/dunnhumby/
!data/processed/dataco/
!data/processed/olist/
!data/processed/m5/
!data/processed/dunnhumby/.gitkeep
!data/processed/dataco/.gitkeep
!data/processed/olist/.gitkeep
!data/processed/m5/.gitkeep

# --- Frontend build output ----------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# --- Model artefacts & vector store -------------------------
*.joblib
*.pkl
*.sqlite3
backend/ai/rag/vector_store/

# --- Power BI / Office temp files ---------------------------
~$*.pbix
~$*.xlsx

# --- Logs ---------------------------------------------------
*.log
logs/

# --- OS / editor --------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
