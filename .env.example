# ============================================================
# OmniRetail AI Analytics Platform — environment template
#
# HOW TO USE
#   1. Copy this file:   cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env — it is listed in .gitignore
#
# This file is committed. It must never contain a real secret.
# ============================================================

# --- Application --------------------------------------------
APP_NAME=OmniRetail AI Analytics Platform
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL: read/write role ----------------------------
# Used by: data loading scripts, Alembic migrations, FastAPI writes
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=omniretail
POSTGRES_USER=omniretail
POSTGRES_PASSWORD=replace_with_a_long_random_value

# --- PostgreSQL: read-only role -----------------------------
# Used by: every read the API makes — the overview KPIs, the query
# catalogue, the AI analyst and the SQL validator.
#
# This role is granted SELECT only, so even a bad generated query
# cannot damage or delete business data. The API process does not
# hold the read/write password at all: it builds its engine from
# POSTGRES_READONLY_* only.
POSTGRES_READONLY_USER=omniretail_readonly
POSTGRES_READONLY_PASSWORD=replace_with_a_different_long_random_value

# --- Query cost protection ----------------------------------
# Applied as a libpq connect option to EVERY read-only connection,
# so it bounds each statement the API issues — including ones
# issued by SQLAlchemy itself, and any code path added later.
#
# PostgreSQL's default is 0 = wait forever. On a 106M-row database
# with a 59M-row fact table that is an availability risk, not a
# neutral default: one unlucky plan holds a pooled connection for
# as long as it likes.
#
# 300000 ms (5 min) is chosen from a measurement, not a guess. The
# slowest of the 41 verified queries, m5.demand_scale_by_hierarchy,
# is recorded at ~199-210 s by the batch runner. A ceiling below
# that would mean the API cannot serve a query this project has
# already verified; a ceiling far above it would protect nothing.
#
# /api/health reports the value a live connection actually reports
# and returns "degraded" if it disagrees with this one.
#
# 0 disables the guard. That is only honest on a trusted host.
STATEMENT_TIMEOUT_MS=300000

# --- Overview cache ------------------------------------------
# /api/overview runs 26 metric queries, several of them full scans
# of m5.sales_long. Measured cold it takes ~55 seconds, and two
# different pages need those numbers. The computed response is
# reused for this many seconds.
#
# The response carries generated_at, cached and age_seconds, so a
# reused result is always visible, and a response containing any
# source-level error note is never cached.
#
# 0 always recomputes.
OVERVIEW_CACHE_TTL_SECONDS=120

# --- LLM (first needed in Phase 9) --------------------------
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- LLM layer (optional, off by default) ------------------
# The analyst is deterministic and complete without any of this.
# The LLM may write PROSE; it may never supply a FACT. Model
# text is re-checked against the rows the query returned and
# discarded on failure, so a wrong model degrades to the
# deterministic answer rather than to a wrong one.
#
# GET /api/ai/provider/status reports what this process can
# actually reach, rather than restating this file.
#
# LLM_ENABLED is separate from the key on purpose: adding a key
# must never silently change what the API returns.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=400

# --- Retrieval (RAG) ---------------------------------------
# Retrieval is BM25 fused with a TF-IDF/SVD vector index over
# the same passages. Offline, deterministic, no model download.
# See docs/retrieval.md for what it is and what it is not.
#
# Setting RAG_VECTOR_ENABLED=false leaves BM25 as the only
# retriever. Retrieval degrades and /api/ai/search reports
# "bm25-only"; answers stay grounded either way.
RAG_VECTOR_ENABLED=true
RAG_VECTOR_DIMENSIONS=128
RAG_RRF_K=60

# --- Rate limiting -----------------------------------------
# A statement timeout caps one query at 300s. These cap how
# many a caller may start. Token bucket, per API key.
#
# GET /api/rate-limit reports the LIVE configuration and the
# worker-count caveat. /api/health is exempt: a monitoring
# system that gets 429 has to report the service down.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_BURST=40
